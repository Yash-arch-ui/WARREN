# Frontend runtime config - copy to `.env.local` (which is gitignored).
# Authoritative source: frontend/lib/config.ts.
#
# NEXT_PUBLIC_DATA_MODE: "mock" replays bundled demo fixtures (no daemon
#                        needed; default). "live" reads a real `warren serve`.
# NEXT_PUBLIC_API_BASE:  the daemon origin. `warren serve` binds loopback
#                        only, so live mode is local-first: the browser talks
#                        to a `warren serve` running on THIS machine (default
#                        http://127.0.0.1:8801). A hosted site cannot reach a
#                        visitor's loopback, so keep DATA_MODE=mock there.
# NEXT_PUBLIC_DEFAULT_PEER: pre-filled recipient handle; must exist under
#                        [peers] in the daemon's config for live mode.
#
# For the live demo: start `warren serve --port 8801` (plus relays and a
# token-issued wallet), set DATA_MODE=live below, then `npm run dev` (:4100).
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8801
NEXT_PUBLIC_DEFAULT_PEER=bob
