# Frontend runtime config - copy to `.env.local` (which is gitignored). See lib/config.ts.
#
# NEXT_PUBLIC_DATA_MODE: "mock" replays bundled fixtures (no backend needed, default)
#                        "live" hits the FastAPI backend over REST + SSE
# NEXT_PUBLIC_API_BASE:  the backend origin (CORS already allows any localhost port)
#
# For the live demo: start the backend (`cd backend && make run-backend` → :8000),
# set DATA_MODE=live below, then `npm run dev` (serves :4100) and trigger a beat.
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_API_BASE=http://localhost:8000
